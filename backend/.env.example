# Copiar como .env y completar los valores. Nunca subir el .env al repositorio.

# Conexión a SQL Server (adaptador @prisma/adapter-mssql)
DATABASE_URL="sqlserver://localhost:1433;database=NominaGT;user=usuario_app;password=CAMBIAR;encrypt=true;trustServerCertificate=true;"

# Clave para firmar los tokens JWT. Obligatoria: el backend no arranca sin ella.
# Usar una cadena larga y aleatoria, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SECRET_KEY="CAMBIAR_POR_UNA_CLAVE_ALEATORIA_LARGA"

# Envío de correos transaccionales con Brevo
BREVO_KEY="CAMBIAR"
BREVO_SENDER_EMAIL="nomina@empresa.com"
BREVO_SENDER_NAME="Nómina GT"

# Puerto HTTP del backend (por defecto 4000)
PORT=4000

# Orígenes del navegador autorizados por CORS, separados por coma (por defecto http://localhost:4200)
CORS_ORIGIN="http://localhost:4200"
