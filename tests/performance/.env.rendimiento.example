# Copiar como .env.rendimiento (no se sube al repositorio) y completar.
# Backend local (npm run start:dev):       http://localhost:4000/api
# Entorno Docker (nginx reenvía /api):      http://localhost:8080/api
BASE_URL=http://localhost:4000/api
USUARIO=admin
CONTRASENA=
CLAVE=

# Opcionales
VUS=20            # usuarios concurrentes para carga y resistencia (requisito del proyecto: 20)
PAUSA=3           # segundos máximos de "lectura" entre pantallas
# DURACION=5m     # fase estable de cada perfil
# RAMPA=1m        # subidas y bajadas
# LOGINS_POR_SEGUNDO=2
