# Variables para docker-compose.yml. Copiar como .env en la raíz del proyecto.

# Contraseña del usuario sa de SQL Server (mínimo 8 caracteres, con mayúsculas, minúsculas, números y símbolos)
MSSQL_SA_PASSWORD="CAMBIAR.Contrasena2026"
DB_NAME="NominaGT"

# Clave para firmar los tokens JWT (larga y aleatoria)
SECRET_KEY="CAMBIAR_POR_UNA_CLAVE_ALEATORIA_LARGA"

# Correo con Brevo
BREVO_KEY="CAMBIAR"
BREVO_SENDER_EMAIL="nomina@empresa.com"
BREVO_SENDER_NAME="Nómina GT"

# Administrador inicial que crea scripts/init-db.sh (solo si la base no tiene usuarios)
ADMIN_USER="admin"
ADMIN_PASSWORD="CAMBIAR.Admin2026"   # 8-72 caracteres con mayúscula, minúscula, número y símbolo
ADMIN_CLAVE="1234"                   # clave numérica del segundo factor del login
ADMIN_EMAIL="admin@empresa.com"

# Límites de peticiones por minuto y por IP. Subirlos SOLO para pruebas de carga o suites automatizadas
THROTTLE_LIMIT="300"
LOGIN_THROTTLE_LIMIT="10"

# true cuando el sitio se publique por HTTPS (cookie de sesión Secure)
COOKIE_SECURE="false"
